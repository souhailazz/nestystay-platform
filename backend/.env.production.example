# Copy into the deployment secret manager. Do not commit a populated file.
# Staging value; change to Production only after the production provider and
# compliance gates are approved.
ASPNETCORE_ENVIRONMENT=Staging

# The API accepts an ASP.NET configuration key or the short environment alias.
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=nesty_prod;Username=nesty_app;Password=replace-me
ConnectionStrings__Redis=redis:6379,password=replace-me

# The staging deployment is same-origin. Caddy serves the SPA and forwards
# /api/* to the ASP.NET API container.
NESTYSTAY_CORS_ALLOWED_ORIGINS=https://staging.nestystay.net
NESTYSTAY_SESSION_COOKIE_DOMAIN=.nestystay.net
NESTYSTAY_SESSION_COOKIE_SAMESITE=Lax

PUBLIC_APP_URL=https://staging.nestystay.net
NESTYSTAY_SESSION_TOKEN_SECRET=replace-with-at-least-32-random-bytes
NESTYSTAY_TOTP_SECRET_PROTECTION_KEY=replace-with-at-least-32-random-bytes
NESTYSTAY_WEBHOOK_SHARED_SECRET=replace-with-a-random-webhook-secret

# Provider selection and credentials.
OBJECT_STORAGE_PROVIDER=minio
EMAIL_PROVIDER=brevo
EKYC_PROVIDER=alibaba
PAYMENT_PROVIDER=stripe
BUSINESS_MAIL_PROVIDER=zoho
PAYOUT_MODE=manual

STRIPE_SECRET_KEY=sk_live_replace-me
STRIPE_PUBLISHABLE_KEY=pk_live_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
ALIBABA_CLOUD_ACCESS_KEY_ID=replace-with-ram-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret
ALIBABA_CLOUD_SECURITY_TOKEN=
ALIBABA_EKYC_REGION=ap-southeast-1
ALIBABA_EKYC_ENDPOINT=cloudauth-intl.ap-southeast-1.aliyuncs.com
ALIBABA_EKYC_PRODUCT_CODE=eKYC_PRO
ALIBABA_EKYC_SCENE_CODE=NESTYWEB
ALIBABA_EKYC_CALLBACK_URL=https://staging.nestystay.net/api/webhooks/alibaba-ekyc/callback
ALIBABA_EKYC_RETURN_URL=https://staging.nestystay.net/ekyc/complete
ALIBABA_EKYC_CALLBACK_TOKEN=replace-with-random-callback-secret
INSURAGUEST_API_BASE_URL=https://replace-with-insuraguest-endpoint

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=replace-with-minio-app-key
MINIO_SECRET_KEY=replace-with-minio-app-secret
MINIO_BUCKET=nesty-objects
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

BREVO_ENABLED=true
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@nestystay.net
BREVO_SENDER_NAME=NestyStay
BREVO_REPLY_TO_EMAIL=support@nestystay.net
BREVO_REPLY_TO_NAME=NestyStay Support

# Optional feature flags.
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SMS_ENABLED=false
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=OpenStreetMap contributors
