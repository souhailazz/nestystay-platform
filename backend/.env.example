ASPNETCORE_ENVIRONMENT=Development

# Database
ConnectionStrings__Postgres=Host=127.0.0.1;Port=55432;Database=nestystay_dev;Username=<postgres-user>;Password=<postgres-password>

# Session signing and TOTP secret protection
NESTYSTAY_SESSION_TOKEN_SECRET=<at-least-32-bytes-random-secret>
NESTYSTAY_TOTP_SECRET_PROTECTION_KEY=<at-least-32-bytes-random-secret>

# First administrator bootstrap. Enable only for first-run provisioning, then disable/remove.
NESTYSTAY_ADMIN_BOOTSTRAP_ENABLED=false
NESTYSTAY_ADMIN_BOOTSTRAP_EMAIL=<admin-email>
NESTYSTAY_ADMIN_BOOTSTRAP_PASSWORD=<temporary-admin-password>
NESTYSTAY_ADMIN_BOOTSTRAP_DISPLAY_NAME=NestyStay Administrator
NESTYSTAY_ADMIN_BOOTSTRAP_PERMISSIONS=super_administration
NESTYSTAY_ADMIN_BOOTSTRAP_REQUIRE_TOTP=true

# Legacy static tokens. Do not enable in production unless explicitly approved.
NESTYSTAY_ADMIN_TOKEN_SHA256=<sha256-of-local-admin-token>
NESTYSTAY_OPERATOR_TOKEN_SHA256=<sha256-of-local-operator-token>

# Webhooks
NESTYSTAY_WEBHOOK_SHARED_SECRET=<webhook-shared-secret>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-signing-secret>

# Integrations
Integrations__EkycPrimary=AlibabaCloud
Integrations__PaymentPrimary=Stripe
Integrations__StoragePrimary=CloudflareR2
Integrations__InsurancePrimary=InsuraGuest
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key>
ALIBABA_EKYC_TRANSACTION_URL_BASE=https://ekyc-provider.example/start
CLOUDFLARE_R2_UPLOAD_URL_BASE=https://r2-upload.example/upload
CLOUDFLARE_R2_DOWNLOAD_URL_BASE=https://r2-download.example/download
INSURAGUEST_API_BASE_URL=https://api.insuraguest.example

# Optional identity providers
GOOGLE_AUTH_CLIENT_ID=<google-oauth-client-id>
