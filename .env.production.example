# Copy to a secret-managed environment file; never commit the populated file.
POSTGRES_DB=nesty_prod
POSTGRES_USER=nesty_app
POSTGRES_PASSWORD=replace-with-a-long-random-value
REDIS_PASSWORD=replace-with-a-long-random-value
MINIO_ROOT_USER=replace-with-a-long-random-value
MINIO_ROOT_PASSWORD=replace-with-a-long-random-value
MINIO_ACCESS_KEY=replace-with-a-minio-access-key
MINIO_SECRET_KEY=replace-with-a-minio-secret-key
MINIO_REGION=us-east-1
# Public frontend build values (embedded at image-build time).
VITE_API_BASE_URL=/api
VITE_STRIPE_PUBLIC_KEY=pk_live_replace-me
VITE_GOOGLE_CLIENT_ID=
NESTYSTAY_DOMAIN=stay.example.com
PUBLIC_APP_URL=https://stay.example.com
# If frontend and API are separate origins, use app.example.com and
# api.example.com under the same parent domain.
NESTYSTAY_CORS_ALLOWED_ORIGINS=https://app.example.com
NESTYSTAY_SESSION_COOKIE_DOMAIN=.example.com
NESTYSTAY_SESSION_COOKIE_SAMESITE=Lax
NESTYSTAY_SESSION_TOKEN_SECRET=replace-with-32-plus-random-bytes
NESTYSTAY_TOTP_SECRET_PROTECTION_KEY=replace-with-32-plus-random-bytes
NESTYSTAY_WEBHOOK_SHARED_SECRET=replace-with-random-secret
# CSRF uses the API-issued double-submit cookie/header pair; no static secret is stored here.
PAYOUT_MODE=manual
EMAIL_PROVIDER=brevo
BUSINESS_MAIL_PROVIDER=zoho
EKYC_PROVIDER=alibaba
PAYMENT_PROVIDER=stripe
SUPPORT_EMAIL=support@stay.example.com
INFO_EMAIL=info@stay.example.com
BILLING_EMAIL=billing@stay.example.com
STRIPE_SECRET_KEY=sk_live_replace-me
STRIPE_PUBLISHABLE_KEY=pk_live_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
ALIBABA_EKYC_TRANSACTION_URL_BASE=https://replace-with-provider-endpoint
INSURAGUEST_API_BASE_URL=https://replace-with-insurance-endpoint
OBJECT_STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_USE_SSL=false
MINIO_BUCKET=nesty-objects
NESTYSTAY_EMAIL_PROVIDER=brevo
BREVO_ENABLED=true
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@stay.example.com
BREVO_SENDER_NAME=NestyStay
BREVO_REPLY_TO_EMAIL=support@stay.example.com
BREVO_REPLY_TO_NAME="NestyStay Support"
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=replace-with-public-vapid-key
VAPID_PRIVATE_KEY=replace-with-private-vapid-key
VAPID_SUBJECT=mailto:support@stay.example.com
SMS_ENABLED=false
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION="OpenStreetMap contributors"
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-value
MONITORING_ENABLED=true
