# Copy to a secret-managed environment file; never commit the populated file.
POSTGRES_DB=nesty_prod
POSTGRES_USER=nesty_app
POSTGRES_PASSWORD=replace-with-a-long-random-value
REDIS_PASSWORD=replace-with-a-long-random-value
# Private server-local storage. Keep this directory outside the app/web root.
OBJECT_STORAGE_PROVIDER=local
NESTYSTAY_STORAGE_LOCAL_ROOT=/var/lib/nestystay/storage
NESTYSTAY_STORAGE_SIGNING_SECRET=replace-with-32-plus-random-bytes
# Public frontend build values (embedded at image-build time).
VITE_API_BASE_URL=/api
VITE_STRIPE_PUBLIC_KEY=pk_live_replace-me
VITE_GOOGLE_CLIENT_ID=
NESTYSTAY_DOMAIN=staging.nestystay.net
PUBLIC_APP_URL=https://staging.nestystay.net
# The staging deployment is same-origin: Caddy serves the SPA and forwards
# /api/* to the ASP.NET container. Do not deploy a frontend-only container.
NESTYSTAY_CORS_ALLOWED_ORIGINS=https://staging.nestystay.net
NESTYSTAY_SESSION_COOKIE_DOMAIN=.nestystay.net
NESTYSTAY_SESSION_COOKIE_SAMESITE=Lax
NESTYSTAY_SESSION_TOKEN_SECRET=replace-with-32-plus-random-bytes
NESTYSTAY_TOTP_SECRET_PROTECTION_KEY=replace-with-32-plus-random-bytes
NESTYSTAY_WEBHOOK_SHARED_SECRET=replace-with-random-secret
# CSRF uses the API-issued double-submit cookie/header pair; no static secret is stored here.
PAYOUT_MODE=manual
EMAIL_PROVIDER=brevo
BUSINESS_MAIL_PROVIDER=zoho
EKYC_PROVIDER=stripe_identity
PAYMENT_PROVIDER=stripe
SUPPORT_EMAIL=support@nestystay.net
INFO_EMAIL=info@nestystay.net
BILLING_EMAIL=billing@nestystay.net
# Staging uses Stripe test mode. Switch these to live values only for an
# approved Production deployment.
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_PUBLISHABLE_KEY=pk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_IDENTITY_RETURN_URL=https://staging.nestystay.net/booking/{bookingId}/pending
INSURAGUEST_API_BASE_URL=https://replace-with-insurance-endpoint
NESTYSTAY_EMAIL_PROVIDER=brevo
BREVO_ENABLED=true
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@nestystay.net
BREVO_SENDER_NAME=NestyStay
BREVO_REPLY_TO_EMAIL=support@nestystay.net
BREVO_REPLY_TO_NAME="NestyStay Support"
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=replace-with-public-vapid-key
VAPID_PRIVATE_KEY=replace-with-private-vapid-key
VAPID_SUBJECT=mailto:support@nestystay.net
SMS_ENABLED=false
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION="OpenStreetMap contributors"
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-value
MONITORING_ENABLED=true
